---
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20

# Indentation and Limits
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# Pointer & Operator Alignment
DerivePointerAlignment: false
PointerAlignment: Right
AlignOperands: Align
AlignEscapedNewlines: Right

# Brace Placement
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  AfterStruct: false
  AfterEnum: false
  AfterUnion: false
  AfterClass: false
  BeforeElse: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true

# Spacing Rules
SpaceAfterCStyleCast: false
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Include Management
IncludeBlocks: Preserve
SortIncludes: Never
---
